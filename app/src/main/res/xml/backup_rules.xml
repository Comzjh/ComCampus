<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy (API < 31) backup rules, deny-all.
  Mirrors data_extraction_rules.xml; allowBackup="false" already blocks all
  cloud backup on these levels. Kept explicit so a future allowBackup flip
  cannot silently start exporting session/auth/Room data.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
